
.dashboard-page {
    background: #f3f6fb;
    min-height: 100vh;
    color: #182338;
}

.dashboard-header {
    height: 76px;
    background: #101827;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6%;
    color: white;
    box-shadow: 0 3px 12px rgba(0,0,0,.08);
}

.dashboard-user {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
}

.dashboard-user button {
    background: #263750;
    border: 1px solid #3b4e68;
    color: white;
    border-radius: 7px;
    padding: 9px 18px;
    cursor: pointer;
    font-weight: 600;
}

.dashboard-user button:hover {
    background: #3978f6;
}

.dashboard-container {
    width: 88%;
    max-width: 1250px;
    margin: 55px auto;
}

.dashboard-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 35px;
}

.dashboard-heading h1 {
    font-size: 30px;
    margin: 12px 0;
    letter-spacing: -.8px;
}

.dashboard-heading p {
    color: #8792a5;
    font-size: 14px;
}

.dashboard-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.dashboard-card {
    background: white;
    padding: 27px;
    border: 1px solid #e8edf4;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(20,40,70,.03);
}

.dashboard-card span {
    display: block;
    color: #738096;
    font-size: 13px;
    font-weight: 600;
}

.dashboard-card strong {
    display: block;
    font-size: 34px;
    margin: 18px 0 8px;
    color: #182338;
}

.dashboard-card small {
    color: #9aa5b5;
    font-size: 12px;
}

.dashboard-section {
    background: white;
    margin-top: 28px;
    padding: 30px;
    border: 1px solid #e8edf4;
    border-radius: 12px;
}

.dashboard-section h2 {
    font-size: 18px;
    margin-bottom: 12px;
}

.dashboard-section p {
    color: #8792a5;
    font-size: 14px;
    line-height: 1.7;
}

@media (max-width: 750px) {
    .dashboard-header {
        padding: 0 5%;
    }

    .dashboard-container {
        width: 90%;
        margin: 35px auto;
    }

    .dashboard-cards {
        grid-template-columns: 1fr;
    }

    .dashboard-heading h1 {
        font-size: 25px;
    }
}

@media (max-width: 400px) {
    .dashboard-user {
        gap: 10px;
        font-size: 12px;
    }

    .dashboard-user button {
        padding: 8px 12px;
    }

    .brand-logo {
        font-size: 20px;
    }
}

/* ===== GERENCIAMENTO DE CLIENTES ===== */

.section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
}

.section-heading h2 {
    font-size: 20px;
    margin-bottom: 8px;
}

.section-heading p {
    color: #8792a5;
    font-size: 14px;
}

.primary-button,
.secondary-button {
    border: 0;
    border-radius: 7px;
    padding: 11px 18px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: .2s;
}

.primary-button {
    background: #3978f6;
    color: white;
}

.primary-button:hover {
    background: #2864dc;
}

.secondary-button {
    background: #edf1f7;
    color: #40506a;
}

.secondary-button:hover {
    background: #dfe6f0;
}

.clients-table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.clients-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 13px;
}

.clients-table th {
    padding: 15px 12px;
    background: #f7f9fc;
    color: #738096;
    font-weight: 600;
    white-space: nowrap;
    border-bottom: 1px solid #e8edf4;
}

.clients-table td {
    padding: 16px 12px;
    color: #40506a;
    border-bottom: 1px solid #edf0f5;
}

.clients-table tbody tr:hover {
    background: #fafbfd;
}

.table-empty {
    text-align: center;
    color: #8792a5;
    padding: 35px !important;
}

.client-message {
    display: none;
    margin-bottom: 15px;
    padding: 12px 15px;
    border-radius: 7px;
    font-size: 13px;
}

.client-message.visible {
    display: block;
}

.client-message.error {
    background: #fff0f0;
    color: #c0392b;
}

.client-message.success {
    background: #edf9f1;
    color: #218348;
}

.status-label {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
}

.status-label.active {
    background: #e8f8ee;
    color: #218348;
}

.status-label.inactive {
    background: #f0f1f4;
    color: #788397;
}

.table-actions {
    display: flex;
    gap: 7px;
    white-space: nowrap;
}

.table-actions button {
    border: 1px solid #e1e7ef;
    background: white;
    color: #52627a;
    border-radius: 5px;
    padding: 6px 9px;
    font-size: 11px;
    cursor: pointer;
}

.table-actions button:hover {
    border-color: #3978f6;
    color: #3978f6;
}

/* ===== MODAL DE CLIENTES ===== */

.modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(12, 23, 40, .58);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal-overlay[hidden] {
    display: none;
}

.client-modal {
    width: 100%;
    max-width: 480px;
    background: white;
    border-radius: 13px;
    padding: 28px;
    box-shadow: 0 15px 50px rgba(0,0,0,.18);
}

.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 25px;
}

.modal-header h2 {
    font-size: 20px;
    color: #182338;
}

.modal-close {
    border: 0;
    background: transparent;
    color: #8792a5;
    font-size: 28px;
    cursor: pointer;
}

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    color: #40506a;
    font-size: 13px;
    font-weight: 600;
}

.form-group input {
    width: 100%;
    padding: 12px 13px;
    border: 1px solid #dce3ed;
    border-radius: 7px;
    outline: none;
    font-size: 14px;
    color: #182338;
    box-sizing: border-box;
}

.form-group input:focus {
    border-color: #3978f6;
    box-shadow: 0 0 0 3px rgba(57,120,246,.10);
}

.modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 25px;
}

button:disabled {
    opacity: .6;
    cursor: not-allowed;
}

@media (max-width: 750px) {
    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .section-heading .primary-button {
        width: 100%;
    }

    .client-modal {
        padding: 22px;
    }
}

/* Miniatura dos QR Codes */
.qr-code-thumbnail {
    width: 76px;
    height: 76px;
    object-fit: contain;
    display: block;
    padding: 5px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

/* Visualização ampliada do QR Code */
.qr-preview-modal {
    width: min(92vw, 560px);
    max-height: 90vh;
    overflow-y: auto;
    background: #ffffff;
    border-radius: 14px;
    padding: 24px;
}

.qr-preview-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 16px;
}

.qr-preview-content img {
    width: min(100%, 440px);
    height: auto;
    image-rendering: pixelated;
    background: #ffffff;
}

.qr-preview-content p {
    color: #64748b;
    text-align: center;
    margin: 0;
}
